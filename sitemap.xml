---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}{% unless p.noindex or p.url contains '.xml' or p.url contains '.txt' or p.url contains '.webmanifest' or p.url == '/404.html' or p.url contains 'assets/' %}
  <url><loc>{{ p.url | absolute_url }}</loc><lastmod>{{ p.updated | default: site.time | date_to_xmlschema }}</lastmod><changefreq>{% if p.url == '/' or p.url == '/deals/' %}daily{% else %}weekly{% endif %}</changefreq><priority>{% if p.url == '/' %}1.0{% elsif p.url == '/deal-alerts/' or p.url == '/deals/' %}0.9{% else %}0.6{% endif %}</priority></url>{% endunless %}{% endfor %}
{%- for c in site.collections %}{% for d in c.docs %}
  <url><loc>{{ d.url | absolute_url }}</loc><lastmod>{{ d.updated | default: d.date | date_to_xmlschema }}</lastmod><changefreq>monthly</changefreq><priority>0.8</priority></url>{% endfor %}{% endfor %}
</urlset>
